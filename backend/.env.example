# =====================================================================
#  Configuration du backend DriveHub
#
#  1. Copiez ce fichier :  cp .env.example .env   (dans le dossier backend/)
#  2. Remplissez les valeurs. Le fichier .env n'est JAMAIS envoyé sur Git (.gitignore).
#  3. En production : mêmes noms de variables, saisies dans le tableau de bord de l'hébergeur
#     (Render, Railway...) ou dans un .env sur le serveur. Les variables du serveur sont prioritaires.
#
#  Format : NOM=valeur, sans guillemets ni espaces autour du "=". Une ligne qui commence par # est un commentaire.
# =====================================================================

# ---------------------------------------------------------------------
#  Base de données PostgreSQL
#  Local      : jdbc:postgresql://localhost:5432/drivehubDB
#  Neon       : jdbc:postgresql://ep-xxx.eu-central-1.aws.neon.tech/neondb?sslmode=require
#  Docker     : jdbc:postgresql://db:5432/drivehubDB   (service "db" de docker-compose.yml)
# ---------------------------------------------------------------------
DB_URL=jdbc:postgresql://localhost:5432/drivehubDB
DB_USERNAME=postgres
DB_PASSWORD=root

# ---------------------------------------------------------------------
#  Sécurité (OBLIGATOIRE)
#  JWT_SECRET_KEY      : 32 caractères minimum   -> openssl rand -base64 48
#  DATA_ENCRYPTION_KEY : 32 octets en Base64     -> openssl rand -base64 32
#      Chiffre les justificatifs. À garder précieusement (gestionnaire de mots de passe) :
#      si elle est perdue, les justificatifs déjà enregistrés deviennent illisibles.
#      Ne JAMAIS la changer en production une fois des données enregistrées.
# ---------------------------------------------------------------------
JWT_SECRET_KEY=remplacez-moi-par-une-longue-chaine-aleatoire-de-48-caracteres
JWT_EXPIRATION_MINUTES=1440
DATA_ENCRYPTION_KEY=0DLrlOs/D3Svg4kCnrd/dPO3jc1Bp/FNNfS4Qky3x7Q=

# Compte administrateur principal (ROOT) du back-office, créé au premier démarrage
MOCK_ROOT_USERNAME=root@drivehub.cm
MOCK_ROOT_PASSWORD=remplacez-moi

# ---------------------------------------------------------------------
#  Adresses publiques
#  APP_FRONTEND_URL     : adresse du site (liens dans les emails)
#  CORS_ALLOWED_ORIGINS : sites autorisés à appeler l'API, séparés par des virgules
# ---------------------------------------------------------------------
APP_FRONTEND_URL=http://localhost:4200
CORS_ALLOWED_ORIGINS=http://localhost:4200

# ---------------------------------------------------------------------
#  Emails (SMTP). Développement : un compte Gmail + mot de passe d'application.
#  Production : un service transactionnel avec votre domaine (Brevo, Resend...),
#  voir docs/EMAILS-DELIVRABILITE.md pour éviter les spams.
# ---------------------------------------------------------------------
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=votre.adresse@gmail.com
MAIL_PASSWORD=xxxx xxxx xxxx xxxx
MAIL_STARTTLS=true
MAIL_SMTP_AUTH=true
# En local, sans serveur d'emails : laissez ces valeurs, l'envoi échouera et le lien de chaque email
# (vérification, invitation...) s'affichera dans la console du backend : copiez-le dans le navigateur.
# Pour voir les emails eux-mêmes : Mailpit (docker run -p 8025:8025 -p 1025:1025 axllent/mailpit),
# puis MAIL_HOST=localhost, MAIL_PORT=1025, MAIL_STARTTLS=false, MAIL_SMTP_AUTH=false ; boîte sur http://localhost:8025
# Expéditeur affiché (par défaut : MAIL_USERNAME). Production : enlevez le # et mettez no-reply@votre-domaine
# MAIL_FROM=no-reply@drivehub.cm
MAIL_FROM_NAME=DriveHub
# MAIL_REPLY_TO=contact@drivehub.cm
SUPPORT_EMAIL=support@drivehub.cm

# ---------------------------------------------------------------------
#  Stockage des justificatifs (fichiers chiffrés avant d'être enregistrés)
#  DATABASE (par défaut) : dans PostgreSQL, rien d'autre à configurer
#  R2 : Cloudflare R2 (si un jour il y a beaucoup de fichiers) -> remplir R2_*
# ---------------------------------------------------------------------
STORAGE_PROVIDER=DATABASE
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=drivehub-documents

# ---------------------------------------------------------------------
#  Paiement Mobile Money des élèves : SIMULATED (aucun argent) ou CAMPAY
# ---------------------------------------------------------------------
PAYMENT_PROVIDER=SIMULATED
CAMPAY_BASE_URL=https://demo.campay.net/api
CAMPAY_USERNAME=
CAMPAY_PASSWORD=
CAMPAY_WEBHOOK_KEY=

# ---------------------------------------------------------------------
#  Abonnements des auto-écoles (facturation désactivée, voir docs/ABONNEMENTS-ET-PAIEMENTS.md)
# ---------------------------------------------------------------------
BILLING_ENABLED=false
BILLING_TRIAL_DAYS=15

# ---------------------------------------------------------------------
#  Divers
#  SWAGGER_ENABLED : documentation /swagger-ui.html (false en production si l'API n'est pas publique)
#  THYMELEAF_CACHE : true en production (modèles d'emails mis en cache)
#  PORT            : port HTTP (fourni automatiquement par la plupart des hébergeurs)
# ---------------------------------------------------------------------
SWAGGER_ENABLED=true
THYMELEAF_CACHE=false
PORT=8082
