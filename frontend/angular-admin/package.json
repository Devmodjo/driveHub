  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build --prod --aot --build-optimizer --common-chunk --vendor-chunk --optimization --progress --base-href /back-office/",
    "build_docker": "ng build --configuration=docker --aot --build-optimizer --common-chunk --vendor-chunk --optimization --progress --base-href /back-office/",
    "build_docker_debug": "ng build --configuration=dockerdebug --aot --build-optimizer --common-chunk --vendor-chunk --optimization --progress --base-href /back-office/",
    "build_docker_kube": "ng build --configuration=dockerkube --aot --build-optimizer --common-chunk --vendor-chunk --optimization --progress --base-href /back-office/",
    "build_docker_training": "ng build --configuration=dockertraining --aot --build-optimizer --common-chunk --vendor-chunk --optimization --progress --base-href /back-office/",
    "build_release": "ng build --configuration=release --aot --build-optimizer --common-chunk --vendor-chunk --optimization --progress --base-href /back-office/",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "lint": "ng lint",
    "lint:fix": "ng lint --fix",
    "prettier": "prettier --write src/"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "20.0.5",
    "@angular/cdk": "20.0.4",
    "@angular/common": "20.0.5",
